# ── Proxy configuration ───────────────────────────────────────────────
# Copy to .env and fill in. All providers have free tiers (no card needed
# except Vapi's signup credit). Never commit the real .env.

# Persona LLM = Llama 3.3 70B across every provider, so the personality is identical on each fallback.
# The chain tries them in order; set whichever keys you have. Cerebras first (fastest, best for <2s voice).

# Cerebras — fastest, generous free tier, no card: https://cloud.cerebras.ai
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b

# Groq — fast, 100K tokens/day free: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# SambaNova — free developer tier, no card: https://cloud.sambanova.ai
SAMBANOVA_API_KEY=
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct

# OpenRouter — second fallback (same Llama 3.3 70B = consistent voice) + the eval judge runs here too (free): https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
JUDGE_MODEL=google/gemini-2.0-flash-exp:free   # different free model so the judge isn't grading itself

# Google Gemini — OPTIONAL extra fallback only; leave blank to skip (key would start with AIza)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Cal.com — real booking (free): https://cal.com  (Settings → Developer → API keys)
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=          # numeric id of your public event type (e.g. "30 min meeting")
CALCOM_USERNAME=               # your cal.com username (for the slots endpoint)
CALCOM_EVENT_SLUG=             # the event type slug, e.g. "30min"
CALCOM_TIMEZONE=Asia/Kolkata

# GitHub — OPTIONAL read-only token to raise ingest rate limit: https://github.com/settings/tokens
GITHUB_TOKEN=
GITHUB_USERNAME=anishadua

# Retrieval / confidence gate (calibrated on the golden set)
CONFIDENCE_THRESHOLD=0.45      # backstop only; refusal is enforced by the prompt, not this gate
RETRIEVAL_TOP_K=6

# Owner identity (used in the persona prompt + booking defaults)
OWNER_NAME=Anisha Dua
OWNER_EMAIL=anishadua2005@gmail.com
